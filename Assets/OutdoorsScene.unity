--- !u!114 &1249297249
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1249297246}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb62f562c428e1c4db311bdcfb8abff0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueLines:
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u0412\u043E\u0432\u0430 \u043F\u0440\u0438\u0432\u0435\u0442. \u0421\u043B\u0443\u0448\u0430\u0439,
      \u0431\u043B\u0438\u043D, \u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
      \u043C\u043E\u0433\u0443 \u043C\u043E\u043B\u0447\u0430\u0442\u044C."
    voiceClip: {fileID: 8300000, guid: b8cc9e4a16dccf847ad8655c74716aa4, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u041C\u0430\u043C\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u0431\u043E\u044E\u0441\u044C \u2014 \u0442\u044B \u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u043A\u0430\u043A\u0430\u044F \u043E\u043D\u0430 \u0443 \u043D\u0430\u0441
      \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044E\u0449\u0430\u044F. "
    voiceClip: {fileID: 8300000, guid: 8065abe22831cef47a3b970012c0c9b0, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u041A\u043E\u0440\u043E\u0447\u0435, \u0440\u0435\u0431\u044F\u0442\u0430
      \u0438\u0437 \u043C\u043E\u0435\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438,
      \u043D\u0443, \u0442\u044B \u0438\u0445 \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
      \u0441\u0442\u0430\u043B\u0438 \u0441\u043E\u0432\u0441\u0435\u043C \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C\u0438."
    voiceClip: {fileID: 8300000, guid: 6522abf38133f6e45a4c1ad268fd9639, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u041C\u044B \u0440\u0430\u043D\u044C\u0448\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0443\u0432\u043B\u0435\u043A\u0430\u043B\u0438\u0441\u044C \u044D\u0437\u043E\u0442\u0435\u0440\u0438\u043A\u043E\u0439,
      \u0433\u0430\u0434\u0430\u043D\u0438\u044F\u043C\u0438, \u0432\u0435\u0440\u0438\u043B\u0438
      \u0432\u043E \u0432\u0441\u044F\u043A\u043E\u0435 \u043F\u043E\u0442\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0435."
    voiceClip: {fileID: 8300000, guid: 21078caf97cfeae459adda2015b637be, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u0447\u0442\u043E \u044D\u0442\u043E
      \u0432\u0441\u0451 \u043D\u0435\u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435.\u041D\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0424\u0435\u0434\u044F \u0432\u043E\u043E\u0431\u0449\u0435
      \u0431\u0443\u0434\u0442\u043E \u0441 \u043A\u0430\u0442\u0443\u0448\u0435\u043A
      \u0441\u043B\u0435\u0442\u0435\u043B. "
    voiceClip: {fileID: 8300000, guid: f4182a4c28bfb39408a15dfa006d81bf, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u041F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u0435\u0433\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C,
      \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u0432 \u0441\u0435\u0431\u044F,
      \u043D\u043E \u043C\u0435\u043D\u044F \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0441\u043B\u0443\u0448\u0430\u043B. "
    voiceClip: {fileID: 8300000, guid: 7f1d624645b978d4d91fe34160944c89, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u041E\u043D\u0438 \u043D\u0430\u0447\u0430\u043B\u0438 \u0438\u0437\u0434\u0435\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430\u0434 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438,
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u0442\u043E
      \u0440\u0438\u0442\u0443\u0430\u043B\u044B \u0438 \u043D\u0430\u0448\u043B\u0438
      \u043A\u0430\u043A\u0443\u044E-\u0442\u043E \u043A\u043D\u0438\u0433\u0443."
    voiceClip: {fileID: 8300000, guid: dc50e57fa95363a47866cf550ce7c308, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u0424\u0435\u0434\u044F \u0447\u0443\u0442\u044C \u043B\u0438 \u043D\u0435
      \u043F\u043E\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F \u0435\u0439,
      \u0438\u0437 \u0440\u0443\u043A \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0438 \u043D\u0438\u043A\u043E\u043C\u0443 \u043E\u0442\u0434\u0430\u0432\u0430\u0442\u044C
      \u043D\u0435 \u0445\u043E\u0447\u0435\u0442."
    voiceClip: {fileID: 8300000, guid: 5d7766c5fa97e314e9947c934f5a8aa5, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u042F \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E
      \u0432\u0441\u0451 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0438\u0445
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u0438 \u044D\u0442\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B\u0438."
    voiceClip: {fileID: 8300000, guid: 972eca6182f32174cb4001ad3f64b930, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u041D\u043E \u043C\u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0438:
      \xAB\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\xBB,
      \u2014 \u0438 \u043F\u0440\u044F\u043C\u043E \u0443\u0433\u0440\u043E\u0436\u0430\u043B\u0438
      \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u043E\u0439."
    voiceClip: {fileID: 8300000, guid: 0af8f299d521bc54785d3c29885abf71, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0435\u0441\u0442\u0440\u0430 :"
    text: "\u042F, \u0435\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E,
      \u043E\u0447\u0435\u043D\u044C \u043E\u0447\u0435\u043D\u044C \u0431\u043E\u044E\u0441\u044C
      \u0437\u0430 \u0441\u0435\u0431\u044F. \u041D\u0435 \u0437\u043D\u0430\u044E,
      \u0447\u0442\u043E \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u0441\u043E
      \u043C\u043D\u043E\u0439 \u0441\u0434\u0435\u043B\u0430\u0442\u044C."
    voiceClip: {fileID: 8300000, guid: e739450d1dda8e741a36271cf9918143, type: 3}
    delayBeforeNext: 0

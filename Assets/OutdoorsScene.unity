--- !u!114 &399079506
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 399079501}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ecf413ccf5ed0734e9bba54dd6b1e4eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueController
  currentState: 0
  playerInventory: {fileID: 958187591}
  ritualBook: {fileID: 11400000, guid: 9937c98836c068643b36c2530f4a4ba3, type: 2}
  firstMeetLines:
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u042D\u0439 \u043A\u0442\u043E \u0437\u0434\u0435\u0441\u044C"
    voiceClip: {fileID: 8300000, guid: b3ee921adb6637e4e82ba53021d8361e, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u0422\u0438\u0448\u0435, \u0442\u0438\u0448\u0435"
    voiceClip: {fileID: 8300000, guid: 64fd483479ad7934abfd1855feacba8e, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u042D\u0442\u043E \u0447\u0430\u0441\u0442\u043D\u0430\u044F \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F,
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F,
      \u0433\u0434\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435,
      \u0447\u0442\u043E \u0432\u044B \u0434\u0435\u043B\u0430\u043B\u0438 \u043D\u0430
      \u0442\u0440\u0435\u0442\u044C\u0435\u043C \u044D\u0442\u0430\u0436\u0435?..."
    voiceClip: {fileID: 8300000, guid: 2638610bfb2fff94dbba01caab0ab77b, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u0422\u0438\u0448\u0435, \u0442\u044B \u0435\u0451 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u0448\u044C..."
    voiceClip: {fileID: 8300000, guid: ade88c89edeb77a4d87afee556ed0cc3, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u041A\u043E\u0433\u043E \u0435\u0451?"
    voiceClip: {fileID: 8300000, guid: bf90b251fb40bd142b02395c637cedc4, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u0414\u0435\u0432\u0443\u0448\u043A\u0443 \u0432\u0441\u0435\u043B\u0438\u0432\u0448\u0443\u044E
      \u0432 \u0441\u0435\u0431\u044F \u0434\u0435\u043C\u043E\u043D\u0430!! \u041E\u043D\u0430
      \u0445\u043E\u0447\u0435\u0442 \u043D\u0430\u0441 \u0443\u0431\u0438\u0442\u044C."
    voiceClip: {fileID: 8300000, guid: 19d77d8d4a481b249911000237093935, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u0423\u0431\u0438\u0442\u044C\u2026? \u0422\u0430\u043A \u044D\u0442\u043E
      \u0432\u044B \u0441\u043E\u0437\u0434\u0430\u043B\u0438 \u044D\u0442\u043E\u0433\u043E
      \u043C\u043E\u043D\u0441\u0442\u0440\u0430!!! \u0413\u0440\u0451\u0431\u0430\u043D\u043D\u044B\u0435
      \u0441\u0430\u0442\u0430\u043D\u0438\u0441\u0442\u044B."
    voiceClip: {fileID: 8300000, guid: b7677da6b47d56a459f0cfe80e07401b, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u041D\u0435\u0442 \u043C\u044B \u043D\u0435 \u0441\u0430\u0442\u0430\u043D\u0438\u0441\u0442\u044B!
      \u041C\u044B \u0443\u0432\u043B\u0435\u043A\u0430\u0435\u043C\u0441\u044F \u0438\u0437\u043E\u0442\u0435\u0440\u0438\u043A\u043E\u0439
      \u0432\u0435\u0440\u0438\u043C \u0432 \u043F\u043E\u0442\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u0438\u0439
      \u043C\u0438\u0440, \u043D\u0438\u0447\u0435\u043C \u043F\u043B\u043E\u0445\u0438\u043C
      \u043D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u043C\u0441\u044F..."
    voiceClip: {fileID: 8300000, guid: 3a1b3d311a1da46488d4c6ad7daa4b1f, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u0417\u043D\u0430\u0447\u0438\u0442 \u043A\u0430\u043A \u043F\u0440\u0438\u0437\u0432\u0430\u043B\u0438,
      \u0442\u0430\u043A \u0438 \u043E\u0442\u0437\u043E\u0432\u0451\u0442\u0435!"
    voiceClip: {fileID: 8300000, guid: 7868430f909951c488e7ce1281c67f4b, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u041D\u0435\u0442 \u044F \u043D\u0435 \u043C\u043E\u0433\u0443, \u043E\u043D\u0430
      \u0441\u0440\u0430\u0437\u0443 \u043C\u0435\u043D\u044F \u0443\u0431\u044C\u0451\u0442.
      \u041C\u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C..."
    voiceClip: {fileID: 8300000, guid: 3a6593ba18ff26d4895eeb6e7a9c6d6c, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u043F\u0430\u0441\u0442\u044C
      \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0443 \u0438
      \u043D\u0430\u0439\u0442\u0438 \u0442\u0430\u043C \u043A\u043D\u0438\u0433\u0443
      \u0440\u0438\u0442\u0443\u0430\u043B\u043E\u0432..."
    voiceClip: {fileID: 8300000, guid: 1440d3d516aa27641bcbf409042838a9, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E, \u043A\u0430\u043A \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u0442\u044C
      \u0442\u0430\u043A \u0432\u044B, \u043A\u0430\u043A \u0438\u0437\u0431\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0442\u0430\u043A \u0441\u0440\u0430\u0437\u0443 \u043C\u043D\u0435, \u0441\u044B\u043A\u043B\u043E,
      \u0434\u0430\u0436\u0435 \u0432\u043E\u043D \u0441 \u043A\u0443\u043A\u043B\u043E\u0439
      \u0441\u0438\u0434\u0438\u0448\u044C."
    voiceClip: {fileID: 8300000, guid: 77e5a360f234eb14fbd6ba91f7edbdd1, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u041A\u0443\u043A\u043B\u0430 \u043C\u043E\u0439 \u0442\u0430\u043B\u0438\u0441\u043C\u0430\u043D,
      \u0441\u0442\u043E\u0439! \u0415\u0449\u0451 \u044F \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043D\u0430 \u043F\u043E\u043B\u0443 \u0441\u0438\u043C\u0432\u043E\u043B\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u0435\u0451
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E..."
    voiceClip: {fileID: 8300000, guid: 2c6f72fc24eefcf4c91a0eaefb2f309b, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u041E\u0445... \u0441\u043F\u0430\u0441\u0438\u0431\u043E!"
    voiceClip: {fileID: 8300000, guid: 7923744a8278470479fb5b9294be95d4, type: 3}
    delayBeforeNext: 0
  waitingLines:
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u0413\u0434\u0435 \u043A\u043D\u0438\u0433\u0430? \u042F \u0431\u0435\u0437
      \u043D\u0435\u0451 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u044E!"
    voiceClip: {fileID: 8300000, guid: e1088815df655914b9c9d738fd837e9a, type: 3}
    delayBeforeNext: 0
  bookReturnedLines:
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u041D\u0443 \u0447\u0442\u043E \u043C\u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C,
      \u0442\u0430\u043C \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u044B
      \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435 \u0438 \u0440\u0438\u0441\u0443\u043D\u043A\u0438?"
    voiceClip: {fileID: 8300000, guid: f66820d356517ab47a319448df2ab38d, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u0422\u0430\u043A \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E
      \u043D\u0430\u0439\u0442\u0438 5 \u043A\u0430\u043C\u043D\u0435\u0439, \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u0442\u044C
      \u043F\u043E 5 \u0443\u0433\u043B\u0430\u043C \u043F\u0435\u043D\u0442\u043E\u0433\u0440\u0430\u043C\u043C\u044B
      \u0438 \u0437\u0430\u0436\u0435\u0447\u044C \u0441\u0432\u0435\u0447\u0438."
    voiceClip: {fileID: 8300000, guid: 1a04aed5892e8b941b87c61794da9f51, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u0410 \u0433\u0434\u0435 \u043C\u043D\u0435 \u0438\u0445 \u043D\u0430\u0439\u0442\u0438
      ?"
    voiceClip: {fileID: 8300000, guid: 7cd46ba6801451d4d9c9f981dd8c3ea5, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u041E\u0434\u0438\u043D \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u0441\u0442\u043E\u043B\u043E\u0432\u043E\u0439, \u0432\u0442\u043E\u0440\u043E\u0439
      \u0432 \u043C\u0435\u0434 \u0431\u043B\u043E\u043A\u0435, \u0442\u0440\u0435\u0442\u0438\u0439
      \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435, \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044B\u0439
      \u043D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435\u043C \u044D\u0442\u0430\u0436\u0435..."
    voiceClip: {fileID: 8300000, guid: 9645264c3cc67134b838f3b5862ae0ca, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u042D\u0445 \u043B\u0430\u0434\u043D\u043E. \u0427\u043E \u0442\u0430\u043C
      \u043D\u0430\u0439\u0442\u0438, \u0437\u0430\u0436\u0435\u0447\u044C \u0438
      \u0432\u0441\u0451"
    voiceClip: {fileID: 8300000, guid: c71af83739558fe4083cb49d8b2e49e3, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u0414\u0430, \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F,
      \u0435\u0441\u043B\u0438 \u0447\u0442\u043E \u043F\u0440\u0438\u0431\u0435\u0433\u0430\u0439"
    voiceClip: {fileID: 8300000, guid: 81d77f3159d6778449d1036ccdf7e0e6, type: 3}
    delayBeforeNext: 0
  thirdFloorLines:
  - speakerName: "\u0421\u0430\u0442\u0430\u043D\u0438\u0441\u0442 :"
    text: "\u0412\u043E\u0442 \u0442\u044B \u0438 \u043F\u043E\u043F\u0430\u043B\u0441\u044F,
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C
      \u0432 \u043C\u043E\u0435\u0439 \u0432\u043B\u0430\u0441\u0442\u0438..."
    voiceClip: {fileID: 8300000, guid: be047864e58679d4186f0c053391fb61, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u041D\u0435\u0442!"
    voiceClip: {fileID: 8300000, guid: 4b58290043fa15346875e31c8cc2a752, type: 3}
    delayBeforeNext: 0

--- !u!114 &823322267
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 823322264}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb62f562c428e1c4db311bdcfb8abff0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueLines:
  - speakerName: "\u041C\u0430\u043C\u0430 :"
    text: "\u0410\u043B\u043E\u043E \u0412\u043E\u0432, \u0442\u044B \u043D\u0430
      \u0441\u043C\u0435\u043D\u0435?"
    voiceClip: {fileID: 8300000, guid: 41d9784f229787a40871965dddcecc92, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u0414\u0430, \u043F\u0440\u0438\u0432\u0435\u0442"
    voiceClip: {fileID: 8300000, guid: 32d6f114ac0ef724989cd8340370f833, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u041C\u0430\u043C\u0430 :"
    text: "\u0422\u0432\u043E\u044F \u0441\u0435\u0441\u0442\u0440\u0430, \u0441\u043D\u043E\u0432\u0430
      \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C \u0434\u043E\u043C\u043E\u0439,
      \u043D\u0430 \u0437\u0432\u043E\u043D\u043A\u0438 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442,
      \u043D\u0435 \u0437\u043D\u0430\u044E \u0443\u0436\u0435 \u0447\u0442\u043E
      \u0434\u0435\u043B\u0430\u0442\u044C..."
    voiceClip: {fileID: 8300000, guid: 8eb1199a08363e54ba0d5cc193e37075, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u0412\u043E\u0432\u0430 :"
    text: "\u0414\u0430 \u0437\u0430\u0433\u0443\u043B\u044F\u043B\u0430\u0441\u044C
      \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435... \u041A\u0443\u0434\u0430
      \u043E\u043D\u0430 \u0441 \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u043F\u0440\u043E\u043F\u0430\u0434\u0435\u0442"
    voiceClip: {fileID: 8300000, guid: 4debd4af5ba614c44b3a6c4d8f230f77, type: 3}
    delayBeforeNext: 0
  - speakerName: "\u041C\u0430\u043C\u0430 :"
    text: "\u041E\u0445 \u043D\u0435 \u0437\u043D\u0430\u044E, \u043C\u043D\u0435
      \u0435\u0451 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u0434\u0430\u0432\u043D\u043E
      \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u043A\u0430\u043A
      \u0441 \u043D\u0435\u0439 \u0441\u0432\u044F\u0437\u0430\u043B\u0430\u0441\u044C
      \u0442\u0430\u043A \u0432\u0441\u0451 \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0442\u044C
      \u0441\u0442\u0430\u043B\u0430\u2026"
    voiceClip: {fileID: 8300000, guid: af07b28c764c42d46a032f54074c3ec3, type: 3}
    delayBeforeNext: 0
